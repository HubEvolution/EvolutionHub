# ==============================================
# GitHub Linguist — Language Detection Config
# ==============================================

# Build output (Astro/Vite dist, Cloudflare Workers output)
dist/**              linguist-generated=true
.output/**           linguist-generated=true
.astro/**            linguist-generated=true
.wrangler/**         linguist-generated=true
out/**               linguist-generated=true
build/**             linguist-generated=true

# Dependencies (safety fallback)
node_modules/**      linguist-vendored=true

# Explicitly mark TypeScript/JavaScript as primary
*.ts                 linguist-detectable=true
*.tsx                linguist-detectable=true
*.js                 linguist-detectable=true
*.jsx                linguist-detectable=true
*.astro              linguist-detectable=true
